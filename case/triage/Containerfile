FROM docker.io/library/python:3.14-slim

LABEL org.opencontainers.image.title="triage" \
      org.opencontainers.image.description="Triage of alerts with a local model and approval for the course CC" \
      org.opencontainers.image.source="https://github.com/ndum/cc" \
      org.opencontainers.image.licenses="MIT"

WORKDIR /app
COPY triage.py .

USER 10001
ENV PYTHONUNBUFFERED=1 PORT=8080
EXPOSE 8080
CMD ["python3", "/app/triage.py"]
