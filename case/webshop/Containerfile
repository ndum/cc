FROM docker.io/library/python:3.14-slim

LABEL org.opencontainers.image.title="webshop" \
      org.opencontainers.image.description="Web shop of Veloatelier Matte for the course CC" \
      org.opencontainers.image.source="https://github.com/ndum/cc" \
      org.opencontainers.image.licenses="MIT"

WORKDIR /app
COPY app.py .

# The shop runs as an unprivileged user, Kubernetes checks this with runAsNonRoot
USER 10001
ENV PYTHONUNBUFFERED=1 PORT=8080
EXPOSE 8080
CMD ["python3", "/app/app.py"]
