{
  "name": "cc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CC (Cloud Computing), a bilingual course on running a private cloud",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "localize": "node scripts/localize.mjs",
    "check:localize": "node scripts/localize.mjs --check",
    "test:scripts": "node --test scripts/*.test.mjs",
    "build:site": "pnpm --filter ./site run build",
    "dev": "pnpm --filter ./site run dev"
  }
}
